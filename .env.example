# Copy to .env.neon.local and fill in your isolated test project settings.
# pnpm neon:test:create generates .env.neon.test with branch-scoped database,
# Realtime, Object Storage, and subscription credentials. Do not edit it by hand.
NEON_API_KEY=
NEON_PROJECT_ID=
# Use a non-expiring parent branch; tests allocate disposable children of it.
NEON_PARENT_BRANCH_ID=
