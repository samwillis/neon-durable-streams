{
  "name": "@samwillis/durable-streams-neon",
  "version": "0.0.1",
  "private": true,
  "description": "An embeddable Durable Streams server for Neon",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.32.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samwillis/neon-durable-streams.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "import": "./dist/migrations.js"
    },
    "./neon": {
      "types": "./dist/neon.d.ts",
      "import": "./dist/neon.js"
    },
    "./s3": {
      "types": "./dist/s3.d.ts",
      "import": "./dist/s3.js"
    },
    "./subscriptions": {
      "types": "./dist/subscriptions.d.ts",
      "import": "./dist/subscriptions.js"
    },
    "./operations": {
      "types": "./dist/operations.d.ts",
      "import": "./dist/operations.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "pnpm build && vitest run --project integration",
    "check": "pnpm typecheck && pnpm test && pnpm build && tsc --noEmit -p examples/neon-function/tsconfig.json",
    "dev:up": "docker compose up -d --wait",
    "dev:down": "docker compose down",
    "test:package": "node scripts/test-package.mjs",
    "test:conformance": "vitest run --project conformance",
    "test:conformance:hot": "vitest run --project conformance --testNamePattern \"^(Basic Stream Operations|Append Operations|Read Operations|TTL and Expiry Validation|Case-Insensitivity|Content-Type Validation|HEAD Metadata|Caching and ETag|Chunking and Large Payloads|Read-Your-Writes Consistency|JSON Mode|Idempotent Producer Operations)\"",
    "test:neon": "pnpm build && vitest run --project neon",
    "neon:test:create": "node --env-file-if-exists=.env.neon.local scripts/neon-test-environment.mjs create",
    "neon:test:delete": "node --env-file-if-exists=.env.neon.local scripts/neon-test-environment.mjs delete",
    "neon:test:deploy": "pnpm build && node scripts/neon-test-function.mjs",
    "test:function": "vitest run --project function",
    "test:recovery": "vitest run --project recovery"
  },
  "peerDependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@durable-streams/server-conformance-tests": "0.3.7",
    "@neon/functions": "0.11.0",
    "@neon/sdk": "7.15.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "fflate": "0.8.3",
    "neon": "9.9.3",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@neon/realtime": "0.2.1",
    "ipaddr.js": "2.5.0",
    "ws": "8.23.0"
  }
}
